# Copy to deploy/.env (gitignored) and fill in. Nothing here is committed.
# SSH destination that runs Docker (an ~/.ssh/config alias works).
DEPLOY_HOST=user@example-host
# Directory on that host for the compose file and the built client.
DEPLOY_DIR=/srv/brumm
# Existing Docker network your reverse proxy / tunnel reaches containers on.
EDGE_NETWORK=edge
# Name the proxy uses to reach this container on that network (port 80).
EDGE_ALIAS=brumm-web
# Only printed after a deploy.
PUBLIC_URL=https://brumm.example.org
